<mxfile host="drawio"><diagram id="p1" name="1. Quy trình thiết kế"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Đề tài Project 23&lt;/b&gt;&lt;br&gt;proposal Milestone 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="240" height="50" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;1. Đặc tả yêu cầu&lt;/b&gt;&lt;br&gt;PLAN.md §1: thông số T_G / T_Y / T_R / T_WALK, bảng I/O,&lt;br&gt;bảng chuyển 9 trạng thái, quy tắc 1–7" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="380" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;2. Thiết kế kiến trúc / vi kiến trúc&lt;/b&gt;&lt;br&gt;sơ đồ khối traffic_top, FSM Moore 9 trạng thái,&lt;br&gt;time base restart theo pha · diagrams/architecture.drawio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="380" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;3. Mô tả RTL bằng SystemVerilog&lt;/b&gt;&lt;br&gt;strobe_gen → sync_debounce → clk_divider → state_timer&lt;br&gt;→ traffic_fsm → bin2bcd8 → traffic_top · lint: quartus_map&lt;br&gt;&lt;i&gt;&lt;font color='#666666'&gt;Công cụ: VS Code, Quartus II (Analysis &amp;amp; Synthesis)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="380" height="85" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;4. Xác minh chức năng (run_sim.ps1, run_modelsim.ps1)&lt;/b&gt;&lt;br&gt;directed T1–T18 · random 3 seed · checker 8 thuộc tính&lt;br&gt;golden model Python · coverage 9/9 trạng thái, 24/24 cung&lt;br&gt;mutant M1–M6&lt;br&gt;&lt;i&gt;&lt;font color='#666666'&gt;Công cụ: iverilog 0.9.7, ModelSim-Altera 10.1d, Python, GTKWave&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="415" width="380" height="105" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Gỡ lỗi&lt;/b&gt;&lt;br&gt;xem waveform (VCD / GTKWave)&lt;br&gt;log checker, mismatch golden model&lt;br&gt;sửa RTL / testbench&lt;br&gt;thêm test vào bộ directed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="410" width="250" height="115" as="geometry"/></mxCell><mxCell id="n8" value="Tất cả&lt;br&gt;PASS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="445" y="550" width="150" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;5. Tổng hợp logic + timing (run_quartus.tcl)&lt;/b&gt;&lt;br&gt;Quartus II 13.0sp1: Synthesis → Fitter → TimeQuest&lt;br&gt;so sánh Binary / Gray / One-Hot · LE, Fmax, đường găng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="330" y="660" width="380" height="75" as="geometry"/></mxCell><mxCell id="n11" value="Đạt ≥ 100 MHz,&lt;br&gt;≤ 300 LE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="445" y="765" width="150" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;6. Hiện thực trên board DE2&lt;/b&gt;&lt;br&gt;de2_top + .qsf (106 chân) · nạp .sof qua USB-Blaster (JTAG)&lt;br&gt;kịch bản B1–B9, chụp ảnh board" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="875" width="380" height="70" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;7. Tổng hợp kết quả + báo cáo&lt;/b&gt;&lt;br&gt;make_figures.py → results.tex · capture_gtkwave.ps1&lt;br&gt;báo cáo LaTeX IEEEtran" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="975" width="380" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Nghiệm thu / bảo vệ&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1075" width="240" height="45" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Tuần 6&lt;/b&gt;&lt;br&gt;chốt đặc tả, sơ đồ FSM,&lt;br&gt;bảng I/O (proposal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="170" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Tuần 7–9&lt;/b&gt;&lt;br&gt;RTL, tích hợp,&lt;br&gt;waveform đầu tiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="85" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Tuần 10–11&lt;/b&gt;&lt;br&gt;testbench, golden model, SVA,&lt;br&gt;coverage, mutant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="240" height="215" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Tuần 12–13&lt;/b&gt;&lt;br&gt;Quartus, STA, gán chân,&lt;br&gt;so sánh encoding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="240" height="185" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Tuần 14&lt;/b&gt;&lt;br&gt;demo DE2, debug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="240" height="70" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Tuần 15&lt;/b&gt;&lt;br&gt;báo cáo + slide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="240" height="70" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19"